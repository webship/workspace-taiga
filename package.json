{
  "name": "@webship.co/workspace-taiga",
  "version": "1.0.0",
  "description": "Taiga for Webship Workspace: the builder (`cmd-taiga-project.sh`, a site of the open-source agile project management platform, from Taiga's own images as its reference setup runs them, on the project's own PostgreSQL 12, in containers: DDEV, with the default accounts in their roles of a sample Scrum project, its sprint and its user stories) and its tool in every sites folder, the Taiga step pack wired into the testing setup, the user stories of a Taiga project as work items of the tracker family (list, read, analyze, and do the work with the workspace's AI CLI on a branch; comments, status changes, tags and assignees after a person's click, writes off by default; the current sprint as the iteration view), and its AI items in their folders.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-taiga.git"
  },
  "workspacePlugin": {
    "name": "taiga",
    "label": "Taiga",
    "summary": "A builder for Taiga sites with a sample Scrum project on PostgreSQL 12; its user stories as work items",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "typeActions": {
      "taiga": [
        "sites",
        "code"
      ]
    },
    "settingsFile": "plugin.taiga.settings.yml",
    "settingsTemplate": "config/plugin.taiga.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-taiga-project.sh",
        "commands/cmd-tools-taiga-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-taiga.sh"
      ],
      "args": [
        "scripts/args/arg-taiga.sh",
        "scripts/args/arg-taiga-cli.sh"
      ],
      "machine": [
        "scripts/docker-compose.taiga.yaml",
        "scripts/taiga-gateway.conf",
        "scripts/taiga-site.py",
        "scripts/taiga-serve.sh",
        "scripts/taiga-proxy.conf",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/taiga-site-builder.md",
        "ai/agents/taiga-tester.md",
        "ai/agents/taiga-issue-worker.md"
      ],
      "skills": [
        "ai/skills/taiga-scenarios"
      ],
      "commands": [
        "ai/commands/taiga-test.md"
      ],
      "prompts": [
        "ai/prompts/taiga-build-and-test.md",
        "ai/prompts/taiga-issue-to-branch.md"
      ]
    },
    "features": [
      "features/taiga.feature",
      "features/taiga-runtimes.feature"
    ],
    "featuresSite": "cmd-taiga-project.sh ci-taiga --install --add-users --sample-content --runtime docker"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "dependencies": {
    "@webship.co/workspace-tracker": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
